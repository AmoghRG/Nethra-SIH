{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrackRecord",
  "description": "Schema for Section 5.2 tracks.jsonl lines (Output of M2, enriched by M1)",
  "type": "object",
  "required": ["frame", "t", "track_id", "cls", "bbox", "conf"],
  "properties": {
    "frame": {"type": "integer"},
    "t": {"type": "number"},
    "track_id": {"type": "integer"},
    "cls": {
      "type": "string",
      "enum": ["car", "motorcycle", "truck", "bus", "auto", "pedestrian"]
    },
    "bbox": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 4,
      "maxItems": 4,
      "description": "[ymin, xmin, ymax, xmax] in pixels"
    },
    "conf": {"type": "number"},
    "ground_m": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 2,
      "maxItems": 2,
      "description": "[x_m, y_m] in ground plane coordinates"
    },
    "v_mps": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 2,
      "maxItems": 2,
      "description": "[vx, vy] in m/s on ground plane"
    }
  }
}
