{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Calibration",
  "description": "Schema for Section 5.1 calibration.json (Output of M1)",
  "type": "object",
  "required": ["video_id", "homography", "reference_points", "rms_error_m", "location"],
  "properties": {
    "video_id": {"type": "string"},
    "homography": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {"type": "number"},
        "minItems": 3,
        "maxItems": 3
      },
      "minItems": 3,
      "maxItems": 3
    },
    "reference_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pixel", "ground_m", "note"],
        "properties": {
          "pixel": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
          "ground_m": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
          "note": {"type": "string"}
        }
      }
    },
    "rms_error_m": {"type": "number"},
    "location": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 2,
      "maxItems": 2
    }
  }
}
