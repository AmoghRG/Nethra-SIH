# Data and run artefacts — never committed
data/*
!data/.gitkeep
out/*
!out/.gitkeep
bench/results/*
!bench/results/.gitkeep

# Video. Clips are large and belong beside the repo, not in it - a 170 MB
# file is over GitHub's 100 MB hard limit and cannot be pushed at all.
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.m4v

# Model weights
*.pt
*.onnx
*.hef

# Edge buffer
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
